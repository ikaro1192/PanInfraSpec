# Generated by paninfraspec-gen — ansible_spec harness.
# Run with `bundle exec rake spec` from the directory that holds this file.
require 'rake'
require 'rspec/core/rake_task'
require 'ansible_spec'

properties = AnsibleSpec.get_properties

properties.each do |property|
  property['hosts'].each do |host|
    role = property['group']
    desc "Run serverspec for #{host['name']} (group: #{role})"
    RSpec::Core::RakeTask.new("spec:#{host['name']}".to_sym) do |t|
      ENV['TARGET_HOST'] = host['name']
      t.pattern    = "spec/#{role}/*_spec.rb"
      t.rspec_opts = '--format documentation --color'
    end
  end
end

task 'spec:all' => properties.flat_map { |p|
  p['hosts'].map { |h| "spec:#{h['name']}".to_sym }
}

task default: 'spec:all'
